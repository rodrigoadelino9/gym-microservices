# Nginx serve o build do React e atua como API Gateway:
# /api/<servico>/... é encaminhado para o microsserviço correspondente.
# ${PORT}, ${ENROLLMENT_URL} e ${ATTENDANCE_URL} são preenchidos na inicialização
# do container (envsubst da imagem oficial do Nginx).
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Serviços no plano free do Render "dormem" e podem levar ~1 min para acordar
    proxy_connect_timeout 90s;
    proxy_read_timeout 120s;
    proxy_ssl_server_name on;

    location /api/enrollment/ {
        proxy_pass ${ENROLLMENT_URL}/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/attendance/ {
        proxy_pass ${ATTENDANCE_URL}/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/user/ {
        proxy_pass ${USER_URL}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/payment/ {
        proxy_pass ${PAYMENT_URL}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri /index.html;
    }
}
